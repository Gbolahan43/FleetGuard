{
  "project": "fleetguard",
  "model_name": "fleetguard_anomaly_model",
  "algorithm": "IsolationForest",
  "supervised": false,
  "target": "is_anomaly (fuel theft / route abuse / private use / excessive idle)",
  "features": [
    "speed_kmh",
    "fuel_level_pct",
    "engine_on",
    "idle_minutes",
    "hour",
    "day_of_week",
    "is_working_hour",
    "zone_distance_deg",
    "fuel_delta",
    "off_hours_speed",
    "idle_speed_ratio",
    "zone_breach"
  ],
  "n_features": 12,
  "contamination": 0.12,
  "n_estimators": 200,
  "seed": 42,
  "n_records": 4800,
  "n_vehicles": 10,
  "hyperparameters": {
    "bootstrap": false,
    "contamination": 0.12,
    "max_features": 1.0,
    "max_samples": "auto",
    "n_estimators": 200,
    "n_jobs": -1,
    "random_state": 42,
    "verbose": 0,
    "warm_start": false
  }
}