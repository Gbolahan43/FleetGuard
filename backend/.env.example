# =============================================================================
# FleetGuard Backend (Path B) — environment variables
# =============================================================================
#
# Setup:
#   copy .env.example .env
#   cd backend
#   uvicorn app.main:app --reload --port 8080
#
# Run from repo root venv:
#   pip install -r ml/requirements.txt -r backend/requirements.txt
#
# Paths like MODEL_PATH are resolved relative to the **repo root**
# (FleetGuard/), not the backend/ folder.
#
# Do not commit .env — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# AWS
# -----------------------------------------------------------------------------

# Region for Bedrock calls (when BEDROCK_ENABLED=true).
# Must match a region where Claude model access is enabled.
AWS_REGION=us-west-2

# -----------------------------------------------------------------------------
# ML model artifacts
# -----------------------------------------------------------------------------

# Directory containing fleetguard_anomaly_model.pkl, fleetguard_scaler.pkl,
# fleetguard_feature_cols.json (relative to repo root).
# Local dev (default):
MODEL_PATH=ml/models
# Docker / App Runner (absolute path inside container):
# MODEL_PATH=/app/models

# -----------------------------------------------------------------------------
# Amazon Bedrock (AI insights for top-N anomalies)
# -----------------------------------------------------------------------------

# Set true only when AWS credentials are configured and model access is enabled
# in the Bedrock console. false = use built-in fallback text (no API calls).
BEDROCK_ENABLED=false

# Claude Opus 4.6 — use inference profile id (required for invoke):
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
# Foundation model id (availability checks only): anthropic.claude-opus-4-6-v1

# Number of highest-ranked anomalies that receive a Bedrock (or fallback) report.
TOP_N_ANOMALIES=10

# -----------------------------------------------------------------------------
# DynamoDB (optional — not wired in MVP batch path yet)
# -----------------------------------------------------------------------------

# When true (future): write batch anomalies to fleetguard-incidents with source=batch.
# Leave false for local dev and hackathon demo.
PERSIST_INCIDENTS=false

# -----------------------------------------------------------------------------
# CORS (frontend access)
# -----------------------------------------------------------------------------

# Allow browser calls from the Next.js dashboard.
# Local dev — any origin:
CORS_ORIGINS=*
# Tighten for production (comma-separated origins, no spaces):
# CORS_ORIGINS=https://main.YOUR_APP_ID.amplifyapp.com,http://localhost:3000

# -----------------------------------------------------------------------------
# Quick reference — typical profiles
# -----------------------------------------------------------------------------
#
# Local dev (no AWS):
#   BEDROCK_ENABLED=false
#   MODEL_PATH=ml/models
#   CORS_ORIGINS=*
#
# Local dev (with Bedrock):
#   BEDROCK_ENABLED=true
#   AWS_REGION=us-west-2
#   Set AWS profile in the shell (not in this file):
#     $env:AWS_PROFILE = "fleetguard"
#   (aws configure --profile fleetguard)
#
# App Runner / production:
#   MODEL_PATH=/app/models
#   BEDROCK_ENABLED=true
#   CORS_ORIGINS=https://main.YOUR_APP_ID.amplifyapp.com
#   TOP_N_ANOMALIES=10
#
# Frontend env (separate file frontend/.env.local):
#   NEXT_PUBLIC_BATCH_API_URL=http://localhost:8080
#   NEXT_PUBLIC_API_URL=<API Gateway URL for Path A>
