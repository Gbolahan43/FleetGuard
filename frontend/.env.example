# Copy to `.env.local` for local dev. Set in Amplify Console for production.

# Path A — API Gateway HTTP API (Live Monitor). Leave empty to use mock data locally.
NEXT_PUBLIC_API_URL=

# Path B — App Runner or local FastAPI (Analyze Logs)
NEXT_PUBLIC_BATCH_API_URL=http://127.0.0.1:8080

# Server-only — Bedrock for /api/analyze (Live alert drilldown)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
