# Copy to `.env.local` for local dev. Set in Amplify Console for production.
# Live URLs: docs/deploy-urls.md

# Path A — API Gateway HTTP API (Live Monitor). Leave empty for demo mode (CSV + Path B).
NEXT_PUBLIC_API_URL=

# Path B — App Runner (deployed) or http://127.0.0.1:8080 for local uvicorn
NEXT_PUBLIC_BATCH_API_URL=https://vxyrxhcfwr.us-west-2.awsapprunner.com

# Server-only — Bedrock for /api/analyze (Live alert drilldown)
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-6-v1
